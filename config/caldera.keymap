#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // Right innermost thumb is dedicated Fn; its neighbor is Space.
            // Keep left Space/Fn for access when only the left half is powered.
            bindings = <
&kp ESCAPE  &kp N1    &kp N2    &kp N3       &kp N4     &kp N5      &kp N6     &kp N7     &kp N8     &kp N9     &kp N0    &kp BSPC
&kp TAB     &kp Q     &kp W     &kp E        &kp R      &kp T       &kp Y      &kp U      &kp I      &kp O      &kp P     &kp BSLH
&kp CAPS    &kp A     &kp S     &kp D        &kp F      &kp G       &kp H      &kp J      &kp K      &kp L      &kp SEMI  &kp RET
&kp LSHFT   &kp Z     &kp X     &kp C        &kp V      &kp B       &kp N      &kp M      &kp COMMA  &kp DOT    &kp FSLH  &kp APOS
&kp LCTRL   &kp LALT  &kp LGUI  &lt 1 SPACE  &kp GRAVE  &kp SPACE   &mo 1      &kp SPACE  &kp LEFT   &kp DOWN   &kp UP    &kp RIGHT
            >;
        };

        lower_layer {
            // Fn + 1..0 = F1..F10; the two end keys give F11/F12.
            // Symbol pairs stay together; right home row provides navigation.
            // Hold Fn + Tab for the system layer.
            bindings = <
&kp F11    &kp F1    &kp F2    &kp F3    &kp F4     &kp F5     &kp F6    &kp F7     &kp F8    &kp F9    &kp F10    &kp F12
&mo 2      &kp EXCL  &kp AT    &kp HASH  &kp DLLR   &kp PRCNT  &kp CARET &kp AMPS   &kp ASTRK &kp UNDER &kp PLUS   &kp PIPE
&kp DEL    &kp LBKT  &kp RBKT  &kp LPAR  &kp RPAR   &kp MINUS  &kp LEFT  &kp DOWN   &kp UP    &kp RIGHT &kp COLON  &trans
&trans     &kp LBRC  &kp RBRC  &kp LT    &kp GT     &kp EQUAL  &kp HOME  &kp PG_DN  &kp PG_UP &kp END   &kp QMARK  &kp DQT
&trans     &trans    &trans    &trans    &kp TILDE  &trans     &trans    &trans     &trans    &trans    &trans     &trans
            >;
        };

        system_layer {
            // Hold Fn + Tab. Profile numbers match the printed number keys.
            // G clears only the selected computer profile. Other positions
            // are deliberately inactive except modifiers, spaces and Fn.
            bindings = <
&none   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4   &none       &none        &none        &none        &none        &none
&trans  &out OUT_USB  &out OUT_BLE  &none         &none         &none          &kp C_PREV  &kp C_PP     &kp C_NEXT   &kp C_BRI_DN &kp C_BRI_UP &none
&none   &none        &none         &none         &none         &bt BT_CLR     &kp C_MUTE  &kp C_VOL_DN &kp C_VOL_UP &none        &none        &none
&trans  &none        &none         &none         &none         &none          &none       &none        &none        &none        &none        &none
&trans  &trans       &trans        &trans        &none         &trans         &trans      &trans       &none        &none        &none        &none
            >;
        };
    };
};
